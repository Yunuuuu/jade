{
    "version": "1.29.1",
    "description": "An installer for the systems programming language Rust",
    "homepage": "https://rustup.rs",
    "license": "MIT|Apache-2.0",
    "notes": [
        "there are two ABIs in use on Windows: the native (MSVC) ABI used by Visual Studio, and the GNU ABI used by the GCC toolchain",
        "This package defaults to the GNU toolchain for new installations; To change this, run:",
        "",
        "rustup set default-host <host-triple>",
        "",
        "The MSVC toolchain requires Microsoft C++ Build Tools: https://visualstudio.microsoft.com/visual-cpp-build-tools/",
        "When installing build tools for MSVC toolchain, these two components should be selected:",
        "- MSVC - VS C++ x64/x86 build tools",
        "- Windows SDK",
        "For details, see: https://rust-lang.github.io/rustup/installation/windows-msvc.html",
        "",
        "No Rust toolchain is installed by default.",
        "To install and set the stable toolchain as the default, run:",
        "",
        "rustup default stable",
        "",
        "To install a toolchain without making it the default, run:",
        "",
        "rustup toolchain install <toolchain>"
    ],
    "architecture": {
        "32bit": {
            "url": "https://static.rust-lang.org/rustup/dist/i686-pc-windows-msvc/rustup-init.exe",
            "hash": "c036fd639f3a1df5ba673e5f5c2decc685c3881dfb3ea8dbd21c439f9ed643a0"
        },
        "64bit": {
            "url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe",
            "hash": "6f4bef66261261fcb43131be8720bab817d403a09edec7455c371974b90bdb7e"
        },
        "arm64": {
            "url": "https://static.rust-lang.org/rustup/dist/aarch64-pc-windows-msvc/rustup-init.exe",
            "hash": "01aa49cf9574a8bd0ae52005d7de2590e8f27181ded6748236e702c92aef826d"
        }
    },
    "installer": {
        "script": [
            "$persist_items = @()",
            "$rustup_home = Get-EnvVar -Name 'RUSTUP_HOME' -Global:$global",
            "if ([string]::IsNullOrWhiteSpace($rustup_home)) {",
            "    $persist_items += '.rustup'",
            "    $rustup_home = \"$persist_dir\\.rustup\"",
            "    Set-EnvVar -Name 'RUSTUP_HOME' -Value $rustup_home -Global:$global",
            "    $env:RUSTUP_HOME = $rustup_home",
            "}",
            "$cargo_home = Get-EnvVar -Name 'CARGO_HOME' -Global:$global",
            "if ([string]::IsNullOrWhiteSpace($cargo_home)) {",
            "    $persist_items += '.cargo'",
            "    $cargo_home = \"$persist_dir\\.cargo\"",
            "    Set-EnvVar -Name 'CARGO_HOME' -Value $cargo_home -Global:$global",
            "    $env:CARGO_HOME = $cargo_home",
            "}",
            "$Manifest | Add-Member -MemberType NoteProperty -Name 'persist' -Value $persist_items -Force",
            "Add-Path -Path '%CARGO_HOME%\\bin' -Global:$global",
            "$host_arch = switch ($architecture) { '64bit' { 'x86_64' } '32bit' { 'i686' } 'arm64' { 'arm64' } }",
            "$rustupArgs = @(",
            "    '-q'",
            "    '-y'",
            "    '--default-host'",
            "    \"$host_arch-pc-windows-gnu\"",
            "    '--default-toolchain'",
            "    'none'",
            "    '--no-update-default-toolchain'",
            "    '--no-modify-path'",
            ")",
            "Invoke-ExternalCommand \"$dir\\rustup-init.exe\" $rustupArgs | Out-Null"
        ]
    },
    "post_uninstall": [
        "function Remove-EnvIfDefault([string]$Name, [string]$DefaultValue) {",
        "    if ((Get-EnvVar -Name $Name -Global:$global) -eq $DefaultValue) {",
        "        Set-EnvVar -Name $Name -Value $null -Global:$global",
        "    }",
        "}",
        "Remove-Path -Path '%CARGO_HOME%\\bin' -Global:$global",
        "Remove-EnvIfDefault 'RUSTUP_HOME' \"$persist_dir\\.rustup\"",
        "Remove-EnvIfDefault 'CARGO_HOME' \"$persist_dir\\.cargo\"",
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'rustup') `",
        "        (Join-Path $env:LOCALAPPDATA 'rustup') `",
        "        (Join-Path $env:APPDATA 'cargo') `",
        "        (Join-Path $env:LOCALAPPDATA 'cargo')",
        "}"
    ],
    "checkver": {
        "url": "https://sh.rustup.rs",
        "regex": "rustup-init ([\\d.]+) \\("
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe"
            },
            "32bit": {
                "url": "https://static.rust-lang.org/rustup/dist/i686-pc-windows-msvc/rustup-init.exe"
            },
            "arm64": {
                "url": "https://static.rust-lang.org/rustup/dist/aarch64-pc-windows-msvc/rustup-init.exe"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
