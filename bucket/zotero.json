    "license": "AGPL-3.0-only",
    "url": "https://download.zotero.org/client/release/10.0.6/Zotero-10.0.6_win-x64.zip",
    "hash": "264b8337b9b412d2b22c369e3885a9bb9331c56b7b46b77e90347d745b6cc132",
    "extract_dir": "Zotero_win-x64",
    "bin": "zotero.exe",
    "shortcuts": [
        [
            "zotero.exe",
            "Zotero"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'Zotero') `",
        "        (Join-Path $env:LOCALAPPDATA 'Zotero') `",
        "        (Join-Path $env:USERPROFILE 'Zotero')",
        "}"
    ],
    "checkver": {
        "url": "https://github.com/zotero/zotero/tags",
        "regex": "tag/(\\d+\\.\\d+\\.\\d+)"
    },
    "autoupdate": {
        "url": "https://download.zotero.org/client/release/$version/Zotero-$version_win-x64.zip",
        "hash": {
            "mode": "download"
        }
    }
}
