{
    "version": "mame0289",
    "description": "Arcade machine emulator",
    "homepage": "http://mamedev.org",
    "license": {
        "identifier": "GPL-2.0",
        "url": "https://github.com/mamedev/mame/blob/master/COPYING"
    },
    "notes": [
        "Learn more at https://docs.mamedev.org/",
        "Following site may be useful, use them at your own risk:",
        "  1. https://www.planetemu.net/machine/mame",
        "  2. https://archive.org/details/mame-merged"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/mamedev/mame/releases/download/mame0289/mame0289b_64bit.exe#/dl.7z",
            "hash": "f4cb463256c34b6772aee5bc553e770aca8204c31f1f947e849d8f8495bc6346"
        },
        "arm64": {
            "url": "https://github.com/mamedev/mame/releases/download/mame0289/mame0289b_arm64.exe#/dl.7z",
            "hash": "a1aa7912168c9d1b05e611906bc21b8b9be3935822aead36d12a1da363150b7d"
        }
    },
    "installer": {
        "script": [
            "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" `",
            "    'roms' `",
            "    'hash' `",
            "    'samples' `",
            "    'artwork' `",
            "    'ctrlr' `",
            "    'ini' `",
            "    'font' `",
            "    'cheat' `",
            "    'crosshair' `",
            "    'plugins' `",
            "    'language' `",
            "    'software' `",
            "    'history' `",
            "    'folders' `",
            "    'cabinets' `",
            "    'cabdevs' `",
            "    'cpanel' `",
            "    'pcb' `",
            "    'flyers' `",
            "    'titles' `",
            "    'ends' `",
            "    'marquees' `",
            "    'artwork preview' `",
            "    'bosses' `",
            "    'logo' `",
            "    'scores' `",
            "    'versus' `",
            "    'gameover' `",
            "    'howto' `",
            "    'select' `",
            "    'icons' `",
            "    'covers'"
        ]
    },
    "bin": [
        [
            "mame.exe",
            "mame",
            "-inipath .;ini;%USERPROFILE%/.config/mame/ini;%APPDATA%/mame;$persist_dir/ini;$persist_dir/ini/presets"
        ],
        [
            "chdman.exe",
            "chdman"
        ]
    ],
    "shortcuts": [
        [
            "mame.exe",
            "MAME",
            "-inipath .;ini;%USERPROFILE%/.config/mame/ini;%APPDATA%/mame;$persist_dir/ini;$persist_dir/ini/presets"
        ]
    ],
    "post_install": [
        "$app_dir = \"$persist_dir\".Replace('\\', '/')",
        "if (!(Test-Path \"$persist_dir\\ini\\mame.ini\")) {",
        "    $main_content = Get-Content \"$bucketsdir\\jade\\config\\mame\\mame.ini\"",
        "    $main_content = $main_content.Replace('$app_dir', $app_dir)",
        "    Set-Content -Path \"$persist_dir\\ini\\mame.ini\" -value $main_content",
        "}",
        "if (!(test-path \"$persist_dir\\ini\\ui.ini\")) {",
        "    $ui_content = Get-Content \"$bucketsdir\\jade\\config\\mame\\ui.ini\"",
        "    $ui_content = $ui_content.Replace('$app_dir', $app_dir)",
        "    Set-Content -Path \"$persist_dir\\ini\\ui.ini\" -value $ui_content",
        "}"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'mame') `",
        "        (Join-Path $env:LOCALAPPDATA 'mame')",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/mamedev/mame",
        "regex": "\\/releases\\/tag\\/([\\d.a-zA-Z]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mamedev/mame/releases/download/$version/$versionb_x64.exe#/dl.7z",
                "hash": {
                    "url": "https://github.com/mamedev/mame/releases/download/$version/SHA256SUMS",
                    "find": "([a-fA-F0-9]{64})\\s*\\*$versionb_arm64.exe"
                }
            },
            "arm64": {
                "url": "https://github.com/mamedev/mame/releases/download/$version/$versionb_arm64.exe#/dl.7z",
                "hash": {
                    "url": "https://github.com/mamedev/mame/releases/download/$version/SHA256SUMS",
                    "find": "([a-fA-F0-9]{64})\\s*\\*$versionb_x64.exe"
                }
            }
        }
    }
}
