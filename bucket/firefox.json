{
    "version": "157.0.1",
    "description": "Popular open source web browser.",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/157.0.1/win32/en-US/Firefox%20Setup%20157.0.1.exe#/dl.7z",
            "hash": "sha512:ba9ab0614bea21eb948a1ce7757a131b82b5242c7f6e1d91936b55713a0c79bc49af4fd746e1f01e9ccca3de41810da5b778289cbfefadc946f56e89e39b143e"
        },
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/157.0.1/win64/en-US/Firefox%20Setup%20157.0.1.exe#/dl.7z",
            "hash": "sha512:5e9cb7c6b8d00e2eb780350b03a4915f637dce4696205802535bad50b486cb8b4ee9afcfdcafd1b3bb75b31541c68db63a2e0da891c8b5b1248e3b681330ec57"
        },
        "arm64": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/157.0.1/win64-aarch64/en-US/Firefox%20Setup%20157.0.1.exe#/dl.7z",
            "hash": "sha512:5121064541871ab18682145b189257b06dce70efa0361111a0785aefeac4f8debf9db6003ac95319bdd17d153bf605a2b1f8d40039e16c255a0f8b8dcb70d0a0"
        }
    },
    "extract_dir": "core",
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" 'distribution' 'profile'"
    },
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'Firefox') `",
        "        (Join-Path $env:LOCALAPPDATA 'Firefox')",
        "}"
    ],
    "checkver": {
        "url": "https://www.mozilla.org/en-US/firefox/releasenotes/",
        "regex": "/([\\d.]+)/releasenotes"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            },
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "arm64": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64-aarch64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64-aarch64/en-US/$basename"
                }
            }
        }
    }
}
