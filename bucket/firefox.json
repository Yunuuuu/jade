{
    "version": "154.0.1",
    "description": "Popular open source web browser.",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0.1/win32/en-US/Firefox%20Setup%20154.0.1.exe#/dl.7z",
            "hash": "sha512:42b65080edae2bff49707e9a7ba7d483a27c735f5c3c181ff685c0611dd98d6ce6337094e70e88bcdeace9d806f1b079079085d809fdd03faeb69e859920f3f9"
        },
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0.1/win64/en-US/Firefox%20Setup%20154.0.1.exe#/dl.7z",
            "hash": "sha512:869ca1b1cddeaed07587ec11477e636695d8bdc19c470c0443220398d8cd6b57374f196d1f2a8b83080b23b2ca0f572e3a8fc06796dc5f66d0694f67c2cc6874"
        },
        "arm64": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0.1/win64-aarch64/en-US/Firefox%20Setup%20154.0.1.exe#/dl.7z",
            "hash": "sha512:3aca801891394c2a6b9b0af7c6edfff078161e2e8aea3bb6aeb61dda0ecfbaed87fe0c8460a1d3fcc324af886e9e0680d7d7dcbb4bb0eef3976994d3f29f0111"
        }
    },
    "extract_dir": "core",
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" 'distribution' 'profile'"
    },
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'Firefox') `",
        "        (Join-Path $env:LOCALAPPDATA 'Firefox')",
        "}"
    ],
    "checkver": {
        "url": "https://www.mozilla.org/en-US/firefox/releasenotes/",
        "regex": "/([\\d.]+)/releasenotes"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            },
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "arm64": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64-aarch64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64-aarch64/en-US/$basename"
                }
            }
        }
    }
}
