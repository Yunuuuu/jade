{
    "version": "153.0.3",
    "description": "Popular open source web browser.",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/153.0.3/win32/en-US/Firefox%20Setup%20153.0.3.exe#/dl.7z",
            "hash": "sha512:1b104b2a1654db7b2e5f530755da40fc99e058273efb3b0466274306c1cce1da29b3dca1de511b4b5e879cdaee3de9b2ed0d8183c73b629831a5f7f8c3af912e"
        },
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/153.0.3/win64/en-US/Firefox%20Setup%20153.0.3.exe#/dl.7z",
            "hash": "sha512:9698b1a4dd42ed5d7bb84bd55091a5ff82bf32f1a3bd1fd2c3e40f09db14554882f4409ebc713deb85162a459686d40731c96d8993e5bcd68cf8815809cdf485"
        },
        "arm64": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/153.0.3/win64-aarch64/en-US/Firefox%20Setup%20153.0.3.exe#/dl.7z",
            "hash": "sha512:fa50a39bd7a0bcffd4a0aafffa45ef4fc512168b33733c1efb3aa471d82bb3eec73aa0222fb96d32c40914176b4584c46e340e7b500ae9bca3fc62e04631490c"
        }
    },
    "extract_dir": "core",
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" 'distribution' 'profile'"
    },
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'Firefox') `",
        "        (Join-Path $env:LOCALAPPDATA 'Firefox')",
        "}"
    ],
    "checkver": {
        "url": "https://www.mozilla.org/en-US/firefox/releasenotes/",
        "regex": "/([\\d.]+)/releasenotes"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            },
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "arm64": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64-aarch64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64-aarch64/en-US/$basename"
                }
            }
        }
    }
}
