{
    "version": "156.0",
    "description": "Popular open source web browser.",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0/win32/en-US/Firefox%20Setup%20156.0.exe#/dl.7z",
            "hash": "sha512:cf84f5ac4e6ab7e7301b8a522bbd8262d3d4ab726a330d5a4a0b728ddfa43c9677f35a5a4f009a0ec0de94f21b7ffdb45115d35eb23f69efb56de03d85d30745"
        },
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0/win64/en-US/Firefox%20Setup%20156.0.exe#/dl.7z",
            "hash": "sha512:8358a7fcb6e8168f9344d137fec05589e278884a05e3e4d60ba71042b7570366daaffc2de4e69f48f32e7669dadc5e806daf73b04f62fcf540b1fd2b1a969913"
        },
        "arm64": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0/win64-aarch64/en-US/Firefox%20Setup%20156.0.exe#/dl.7z",
            "hash": "sha512:ab7cd97e6a2be6303975ad1a5fbfa81b74bee3943d8ff1d45d3d2da6ea954ac2ea728f67bf3eb19db05e2df6f46cbad33924569d069bc2c38571c7afd43d30b2"
        }
    },
    "extract_dir": "core",
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" 'distribution' 'profile'"
    },
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'Firefox') `",
        "        (Join-Path $env:LOCALAPPDATA 'Firefox')",
        "}"
    ],
    "checkver": {
        "url": "https://www.mozilla.org/en-US/firefox/releasenotes/",
        "regex": "/([\\d.]+)/releasenotes"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            },
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "arm64": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64-aarch64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64-aarch64/en-US/$basename"
                }
            }
        }
    }
}
