{
    "version": "159.0",
    "description": "Popular open source web browser.",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/159.0/win32/en-US/Firefox%20Setup%20159.0.exe#/dl.7z",
            "hash": "sha512:73a3b6c5e1ace4a18efdeebded304a2f7fcd8d5695f61ffb399cd274b09f20226a1b633daa20d91a0b032ea73c945cd73f6feb5fbe84c6d5102eef93a11c2499"
        },
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/159.0/win64/en-US/Firefox%20Setup%20159.0.exe#/dl.7z",
            "hash": "sha512:fabd5c7608aec3d6945c2a2038a32cc67b159bd36997598725c90cb042e86a2570a97cc0b1bb4763643ab42dda71c00e4fa242fd52c63b57c6cec9d70b3c1aa5"
        },
        "arm64": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/159.0/win64-aarch64/en-US/Firefox%20Setup%20159.0.exe#/dl.7z",
            "hash": "sha512:0901cac52aaa86223a5d787b10351cd5bb4423c9c076463425bd431efaabfbf93388d77451c80d1c12bbf6148e818c31d2626e1ea55671299f656ec5b225568a"
        }
    },
    "extract_dir": "core",
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" 'distribution' 'profile'"
    },
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'Firefox') `",
        "        (Join-Path $env:LOCALAPPDATA 'Firefox')",
        "}"
    ],
    "checkver": {
        "url": "https://www.mozilla.org/en-US/firefox/releasenotes/",
        "regex": "/([\\d.]+)/releasenotes"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            },
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "arm64": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64-aarch64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64-aarch64/en-US/$basename"
                }
            }
        }
    }
}
