{
    "version": "0.76.1",
    "description": "Package management made easy",
    "homepage": "https://pixi.sh",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/prefix-dev/pixi/releases/download/v0.76.1/pixi-x86_64-pc-windows-msvc.zip",
            "hash": "ca64d56112cbebd96b4ec76ff220d59436ad5b6428a0e97242b3e549d65a39be"
        },
        "arm64": {
            "url": "https://github.com/prefix-dev/pixi/releases/download/v0.76.1/pixi-aarch64-pc-windows-msvc.zip",
            "hash": "8464b16326562b720157162c50f706598ba75634c5c73375be687b810cc81135"
        }
    },
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" '.pixi' '.cache'"
    },
    "bin": "pixi.exe",
    "env_add_path": ".pixi\\bin",
    "env_set": {
        "PIXI_CACHE_DIR": "$persist_dir\\.cache",
        "PIXI_HOME": "$persist_dir\\.pixi"
    },
    "persist": [
        ".pixi",
        ".cache"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'pixi') `",
        "        (Join-Path $env:LOCALAPPDATA 'pixi')",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/prefix-dev/pixi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/prefix-dev/pixi/releases/download/v$version/pixi-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            },
            "arm64": {
                "url": "https://github.com/prefix-dev/pixi/releases/download/v$version/pixi-aarch64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
