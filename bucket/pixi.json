{
    "version": "0.77.1",
    "description": "Package management made easy",
    "homepage": "https://pixi.sh",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/prefix-dev/pixi/releases/download/v0.77.1/pixi-x86_64-pc-windows-msvc.zip",
            "hash": "d68b9e6739934cf931a2f7c0a5cedca32c22ea8dcb7293ee29d004a0c32304cc"
        },
        "arm64": {
            "url": "https://github.com/prefix-dev/pixi/releases/download/v0.77.1/pixi-aarch64-pc-windows-msvc.zip",
            "hash": "50e311a44796e68ea71c91c90f196a150c11fbaa65e953e8f6bcf867154b4d38"
        }
    },
    "installer": {
        "script": [
            "$persist_items = @()",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'PIXI_HOME' -Global:$global))) {",
            "    $persist_items += '.pixi'",
            "    Set-EnvVar -Name 'PIXI_HOME' -Value \"$persist_dir\\.pixi\" -Global:$global",
            "}",
            "Add-Path -Path '%PIXI_HOME%\\bin' -Global:$global",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'PIXI_CACHE_DIR' -Global:$global))) {",
            "    $persist_items += '.cache'",
            "    Set-EnvVar -Name 'PIXI_CACHE_DIR' -Value \"$persist_dir\\.cache\" -Global:$global",
            "}",
            "$Manifest | Add-Member -MemberType NoteProperty -Name 'persist' -Value $persist_items -Force"
        ]
    },
    "bin": "pixi.exe",
    "post_uninstall": [
        "function Remove-EnvIfDefault([string]$Name, [string]$DefaultValue) {",
        "    if ((Get-EnvVar -Name $Name -Global:$global) -eq $DefaultValue) {",
        "        Set-EnvVar -Name $Name -Value $null -Global:$global",
        "    }",
        "}",
        "Remove-Path -Path '%PIXI_HOME%\\bin' -Global:$global",
        "Remove-EnvIfDefault 'PIXI_HOME' \"$persist_dir\\.pixi\"",
        "Remove-EnvIfDefault 'PIXI_CACHE_DIR' \"$persist_dir\\.cache\"",
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'pixi') `",
        "        (Join-Path $env:LOCALAPPDATA 'pixi')",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/prefix-dev/pixi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/prefix-dev/pixi/releases/download/v$version/pixi-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            },
            "arm64": {
                "url": "https://github.com/prefix-dev/pixi/releases/download/v$version/pixi-aarch64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
