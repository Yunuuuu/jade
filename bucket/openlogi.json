{
    "version": "0.7.10",
    "description": "A native, local-first alternative to Logitech Options+, written in Rust.",
    "homepage": "https://openlogi.org/",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AprilNEA/OpenLogi/releases/download/v0.7.10/OpenLogi-v0.7.10-windows-x86_64.zip",
            "hash": "567b17a3b297cba23098d2441bec4c39f38b0f3245296dd6c0c006ded4e4be50"
        },
        "arm64": {
            "url": "https://github.com/AprilNEA/OpenLogi/releases/download/v0.7.10/OpenLogi-v0.7.10-windows-arm64.zip",
            "hash": "1f8a6f9e13c04c52fbc6632c496470af38aab438d934071dbcdd708c2c3ea6c2"
        }
    },
    "shortcuts": [
        [
            "OpenLogi.exe",
            "OpenLogi"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:USERPROFILE '.config\\openlogi') `",
        "        (Join-Path $env:USERPROFILE '.local\\share\\openlogi') `",
        "        (Join-Path $env:APPDATA 'openlogi') `",
        "        (Join-Path $env:LOCALAPPDATA 'openlogi')",
        "    & \"$bucketsdir\\jade\\scripts\\purge_empty_dir.ps1\" `",
        "        (Join-Path $env:USERPROFILE '.config') `",
        "        (Join-Path $env:USERPROFILE '.local\\share') `",
        "        (Join-Path $env:USERPROFILE '.local')",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/AprilNEA/OpenLogi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AprilNEA/OpenLogi/releases/download/v$version/OpenLogi-v$version-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/AprilNEA/OpenLogi/releases/download/v$version/OpenLogi-v$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
