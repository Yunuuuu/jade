{
    "version": "0.12.11",
    "description": "An extremely fast Python package installer and resolver, written in Rust.",
    "homepage": "https://docs.astral.sh/uv/",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.11/uv-x86_64-pc-windows-msvc.zip",
            "hash": "e94225dea91e051472847bd6d146d7d66c4f54ffcd1f106678866a99580845f9"
        },
        "32bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.11/uv-i686-pc-windows-msvc.zip",
            "hash": "c5fb5da8a9578ccaf9dadd3622413c347661847ededb4a93d9d3dbf9304a9ea4"
        },
        "arm64": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.11/uv-aarch64-pc-windows-msvc.zip",
            "hash": "7a70f46305d28a95f913ef2888254a9f9c183a406daeeb8937134afc9ed434d2"
        }
    },
    "installer": {
        "script": [
            "$persist_items = @()",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'UV_CACHE_DIR' -Global:$global))) {",
            "    $persist_items += '.cache'",
            "    Set-EnvVar -Name 'UV_CACHE_DIR' -Value \"$persist_dir\\.cache\" -Global:$global",
            "}",
            "$needs_uv_persist = $false",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'UV_CREDENTIALS_DIR' -Global:$global))) {",
            "    $needs_uv_persist = $true",
            "    Set-EnvVar -Name 'UV_CREDENTIALS_DIR' -Value \"$persist_dir\\.uv\\credentials\" -Global:$global",
            "}",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'UV_PYTHON_INSTALL_DIR' -Global:$global))) {",
            "    $needs_uv_persist = $true",
            "    Set-EnvVar -Name 'UV_PYTHON_INSTALL_DIR' -Value \"$persist_dir\\.uv\\python\\versions\" -Global:$global",
            "}",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'UV_PYTHON_BIN_DIR' -Global:$global))) {",
            "    $needs_uv_persist = $true",
            "    Set-EnvVar -Name 'UV_PYTHON_BIN_DIR' -Value \"$persist_dir\\.uv\\python\\bin\" -Global:$global",
            "}",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'UV_TOOL_DIR' -Global:$global))) {",
            "    $needs_uv_persist = $true",
            "    Set-EnvVar -Name 'UV_TOOL_DIR' -Value \"$persist_dir\\.uv\\tools\\envs\" -Global:$global",
            "}",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'UV_TOOL_BIN_DIR' -Global:$global))) {",
            "    $needs_uv_persist = $true",
            "    Set-EnvVar -Name 'UV_TOOL_BIN_DIR' -Value \"$persist_dir\\.uv\\tools\\bin\" -Global:$global",
            "}",
            "if ($needs_uv_persist) {",
            "    $persist_items += '.uv'",
            "}",
            "$Manifest | Add-Member -MemberType NoteProperty -Name 'persist' -Value $persist_items -Force",
            "Add-Path -Path '%UV_PYTHON_BIN_DIR%' -Global:$global",
            "Add-Path -Path '%UV_TOOL_BIN_DIR%' -Global:$global"
        ]
    },
    "bin": [
        "uv.exe",
        "uvx.exe",
        "uvw.exe"
    ],
    "post_uninstall": [
        "function Remove-EnvIfDefault([string]$Name, [string]$DefaultValue) {",
        "    if ((Get-EnvVar -Name $Name -Global:$global) -eq $DefaultValue) {",
        "        Set-EnvVar -Name $Name -Value $null -Global:$global",
        "    }",
        "}",
        "Remove-Path -Path '%UV_PYTHON_BIN_DIR%' -Global:$global",
        "Remove-Path -Path '%UV_TOOL_BIN_DIR%' -Global:$global",
        "Remove-EnvIfDefault 'UV_CACHE_DIR' \"$persist_dir\\.cache\"",
        "Remove-EnvIfDefault 'UV_CREDENTIALS_DIR' \"$persist_dir\\.uv\\credentials\"",
        "Remove-EnvIfDefault 'UV_PYTHON_INSTALL_DIR' \"$persist_dir\\.uv\\python\\versions\"",
        "Remove-EnvIfDefault 'UV_PYTHON_BIN_DIR' \"$persist_dir\\.uv\\python\\bin\"",
        "Remove-EnvIfDefault 'UV_TOOL_DIR' \"$persist_dir\\.uv\\tools\\envs\"",
        "Remove-EnvIfDefault 'UV_TOOL_BIN_DIR' \"$persist_dir\\.uv\\tools\\bin\"",
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'uv') `",
        "        (Join-Path $env:LOCALAPPDATA 'uv')",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/astral-sh/uv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-x86_64-pc-windows-msvc.zip"
            },
            "32bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-i686-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
