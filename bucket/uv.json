{
    "version": "0.12.2",
    "description": "An extremely fast Python package installer and resolver, written in Rust.",
    "homepage": "https://docs.astral.sh/uv/",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.2/uv-x86_64-pc-windows-msvc.zip",
            "hash": "01442d8ce5c7124151a73e697c836d252c6da853c18c73206d3cc4c2378a91d2"
        },
        "32bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.2/uv-i686-pc-windows-msvc.zip",
            "hash": "e2037092f25370ecbd8827b1d91650a9fbf002548ae647aea39073c6bbe45384"
        },
        "arm64": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.2/uv-aarch64-pc-windows-msvc.zip",
            "hash": "dccc2bb7724c015f2a82467dee5bf4b2353a3fcdbfdfb30e0f93cdf5db2dd1df"
        }
    },
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" '.uv' '.cache'"
    },
    "bin": [
        "uv.exe",
        "uvx.exe",
        "uvw.exe"
    ],
    "env_add_path": [
        ".uv\\python\\bin",
        ".uv\\tools\\bin"
    ],
    "env_set": {
        "UV_CACHE_DIR": "$persist_dir\\.cache",
        "UV_CREDENTIALS_DIR": "$persist_dir\\.uv\\credentials",
        "UV_PYTHON_INSTALL_DIR": "$persist_dir\\.uv\\python\\versions",
        "UV_PYTHON_BIN_DIR": "$persist_dir\\.uv\\python\\bin",
        "UV_TOOL_DIR": "$persist_dir\\.uv\\tools\\envs",
        "UV_TOOL_BIN_DIR": "$persist_dir\\.uv\\tools\\bin"
    },
    "persist": [
        ".uv",
        ".cache"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'uv') `",
        "        (Join-Path $env:LOCALAPPDATA 'uv')",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/astral-sh/uv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-x86_64-pc-windows-msvc.zip"
            },
            "32bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-i686-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
