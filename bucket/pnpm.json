{
    "version": "12.21.0",
    "description": "A fast and disk space efficient Node package manager.",
    "homepage": "https://pnpm.io/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.21.0/pnpm-win32-x64.zip",
            "hash": "4fb64bb37e46c788309e0fd4ea93beb512546fdc7348121194fb704fbb72c09c"
        },
        "arm64": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.21.0/pnpm-win32-arm64.zip",
            "hash": "9584890db13a8bcd9a77556f3455e37718a17a31c0aee0254cf8d8ac6b3a8df1"
        }
    },
    "installer": {
        "script": [
            "$persist_items = @()",
            "if ([string]::IsNullOrWhiteSpace((Get-EnvVar -Name 'PNPM_HOME' -Global:$global))) {",
            "    $persist_items += '.pnpm'",
            "    Set-EnvVar -Name 'PNPM_HOME' -Value \"$persist_dir\\.pnpm\" -Global:$global",
            "}",
            "$Manifest | Add-Member -MemberType NoteProperty -Name 'persist' -Value $persist_items -Force",
            "Add-Path -Path '%PNPM_HOME%\\bin' -Global:$global"
        ]
    },
    "bin": [
        "pnpm.exe",
        [
            "pnpm.exe",
            "pn"
        ],
        [
            "pnpm.exe",
            "pnpx",
            "dlx"
        ],
        [
            "pnpm.exe",
            "pnx",
            "dlx"
        ]
    ],
    "post_uninstall": [
        "function Remove-EnvIfDefault([string]$Name, [string]$DefaultValue) {",
        "    if ((Get-EnvVar -Name $Name -Global:$global) -eq $DefaultValue) {",
        "        Set-EnvVar -Name $Name -Value $null -Global:$global",
        "    }",
        "}",
        "Remove-Path -Path '%PNPM_HOME%\\bin' -Global:$global",
        "Remove-EnvIfDefault 'PNPM_HOME' \"$persist_dir\\.pnpm\"",
        "if ($purge) {",
        "    if ($global) {",
        "        & \"$bucketsdir\\jade\\scripts\\purge.ps1\" (Join-Path $env:ProgramData 'pnpm')",
        "    }",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'pnpm') `",
        "        (Join-Path $env:LOCALAPPDATA 'pnpm')",
        "}"
    ],
    "checkver": {
        "script": [
            "# Using checkver script to check through all release tags",
            "$auth = Get-GitHubToken",
            "$head = @{}",
            "if($auth) { $head.add('authorization', \"Bearer $auth\") }",
            "$url = 'https://api.github.com/repos/pnpm/pnpm/releases'",
            "$latest_ver = [Version]::new(0,0,0,0) # note: Powershell 5 does not support casting 'int' or 'float' to 'System.Version'",
            "$releases = $(Invoke-WebRequest -Headers $head $url).Content | ConvertFrom-Json",
            "$releases | ForEach-Object {",
            "    if (!($_.tag_name -match '([\\d.]+)')) { return }",
            "    if ($_.prerelease) { return }",
            "    $ver = [Version]::new($matches[1])",
            "    if ($ver -gt $latest_ver) { $latest_ver = $ver }",
            "}",
            "if ($latest_ver -eq [Version]::new(0,0,0,0)) { error \"Could not match version string in '$url'\"; continue }",
            "Write-Output $latest_ver"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-arm64.zip"
            }
        }
    }
}
