{
    "version": "26.8.0",
    "description": "A feature-rich dictionary lookup program",
    "homepage": "https://github.com/xiaoyifang/goldendict-ng",
    "license": "GPL-3.0-only",
    "url": "https://github.com/xiaoyifang/goldendict-ng/releases/download/v26.8.0/GoldenDict-ng-26.8.0-Qt6.10.3-Windows.7z",
    "hash": "03d52a0381af531b3719e77088404050a196baa59ebef4505b4b58db62eb331b",
    "extract_dir": "GoldenDict-ng-26.8.0-Qt6.10.3",
    "installer": {
        "script": "& \"$bucketsdir\\jade\\scripts\\persist_dir.ps1\" 'portable' 'content'"
    },
    "bin": "GoldenDict.exe",
    "shortcuts": [
        [
            "GoldenDict.exe",
            "GoldenDict"
        ]
    ],
    "persist": [
        "portable",
        "content"
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    & \"$bucketsdir\\jade\\scripts\\purge.ps1\" `",
        "        (Join-Path $env:APPDATA 'GoldenDict-ng') `",
        "        (Join-Path $env:LOCALAPPDATA 'GoldenDict-ng')",
        "}"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/xiaoyifang/goldendict-ng/releases/latest",
        "script": [
            "$assets = json_path $page '$.assets[?(@.name =~ /Windows\\.7z$/)]'",
            "$url = json_path $assets '$[0].browser_download_url'",
            "$version = json_path $page '$.tag_name'",
            "Write-Output \"$version $url\""
        ],
        "regex": "^v(?<Version>[\\d.]+) (?<Url>https://.+/(?<Basename>.+)-Windows\\.7z)$",
        "replace": "${Version}"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "hash": {
            "mode": "github"
        },
        "extract_dir": "$matchBasename"
    }
}
